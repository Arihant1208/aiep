# Local development only. Copy to .env to override the defaults in docker-compose.yml.
# Never put production or real provider credentials here.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_local_dev
AIEP_MIGRATOR_PASSWORD=migrator_local_dev
AIEP_API_PASSWORD=api_local_dev
AIEP_WORKER_PASSWORD=worker_local_dev
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=keycloak_local_dev
# Base64 HMAC pepper for API keys (>= 32 bytes). Synthetic; production uses Key Vault.
AIEP_API_KEY_PEPPER=YWllcC1sb2NhbC1kZXYtcGVwcGVyLU5PVC1BLVNFQ1JFVC0wMDAx
